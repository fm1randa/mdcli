    "@inquirer/prompts": "^8.7.3",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.0.0",
    "eslint": "^10.13.0",
    "knip": "^6.42.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2"
  }
}

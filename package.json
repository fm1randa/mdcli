{
  "name": "mdcli",
  "version": "2026.10.19",
  "description": "Unofficial CLI client for Meu Dinheiro (meudinheiroweb.com.br)",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "bin": {
    "mdcli": "./bin/cli.ts"
  },
  "scripts": {
    "dev": "bun run bin/cli.ts",
    "start": "bun run bin/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "test": "bun test --timeout 20000"
